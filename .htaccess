# WeshTransfer chez o2switch (Apache). Netlify ignore ce fichier.
# Marche que l'on dépose tout le dépôt ou seulement _deploy : seules les
# pages et ressources publiques sortent, le reste (dev/, tools/, supabase/,
# README, migrations...) répond 404 et les dossiers ne sont jamais listés.

DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddCharset utf-8 .html .css .js .txt .svg
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Validation des certificats (AutoSSL, Let's Encrypt) : ni bloquée ni redirigée.
  RewriteRule ^\.well-known/ - [L]

  # Tout en HTTPS : l'appli en a besoin (identifiants aléatoires, presse-papiers,
  # partage). o2switch met un proxy devant Apache, d'où X-Forwarded-Proto,
  # regardé en plus pour ne jamais boucler.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # www -> domaine nu
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Liste blanche
  RewriteRule ^$ - [L]
  RewriteRule ^(index|app|t)\.html$ - [L]
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^(css|js|fonts|img)/[A-Za-z0-9_./-]+\.(css|js|woff2|svg|png|jpg|txt)$ - [L]
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Scripts : le site et jsDelivr seulement, aucun script en ligne. Même si
  # une faille d'injection apparaissait, le navigateur refuserait de
  # l'exécuter. Médias : B2 et le Storage Supabase (anciens fichiers).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.backblazeb2.com https://mqjzzcnzbsbhololiiyw.supabase.co; media-src 'self' blob: https://*.backblazeb2.com https://mqjzzcnzbsbhololiiyw.supabase.co; connect-src 'self' https://mqjzzcnzbsbhololiiyw.supabase.co wss://mqjzzcnzbsbhololiiyw.supabase.co https://*.backblazeb2.com https://cdn.jsdelivr.net; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

  # Les pages changent à chaque version (?v=N) : jamais de HTML en cache,
  # sinon il pointerait vers d'anciens scripts.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # La page destinataire ne doit ni fuiter le lien privé ni être indexée.
  <Files "t.html">
    Header always set Referrer-Policy "no-referrer"
    Header set X-Robots-Tag "noindex, nofollow"
  </Files>
  <Files "app.html">
    Header set X-Robots-Tag "noindex"
  </Files>
</IfModule>
